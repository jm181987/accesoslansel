{
  "manifest_version": 3,
  "name": "LANSEL Access — Autocompletar",
  "version": "1.3.3",
  "description": "Completa con un clic las credenciales corporativas asignadas en Accesos LANSEL.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://accesoslansel.vercel.app/*"
  ],
  "action": {
    "default_title": "LANSEL Access",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/knj-16.png",
      "32": "icons/knj-32.png",
      "48": "icons/knj-48.png"
    }
  },
  "icons": {
    "16": "icons/knj-16.png",
    "32": "icons/knj-32.png",
    "48": "icons/knj-48.png",
    "128": "icons/knj-128.png"
  }
}
